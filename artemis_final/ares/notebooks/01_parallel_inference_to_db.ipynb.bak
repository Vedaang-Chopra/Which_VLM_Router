    "# Final summary\n",
    "if 'all_results' in dir() and all_results:\n",
    "    df_results = pd.DataFrame(all_results)\n",
    "    print(f\"\\nTotal processed: {df_results['processed'].sum()}\")\n",
    "    print(f\"Total errors: {df_results['errors'].sum()}\")\n",
    "    df_results.sort_values('processed', ascending=False)"
   ]
