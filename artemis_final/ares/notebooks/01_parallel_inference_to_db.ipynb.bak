   "source": [
    "# Get configs to process\n",
    "from ares.configs.config import ALL_CAULDRON_CONFIGS\n",
    "\n",
    "# Filter out already-complete splits\n",
    "configs_to_process = []\n",
    "configs_complete = []\n",
    "\n",
    "for cfg in ALL_CAULDRON_CONFIGS:\n",
    "    stats = split_status.get(cfg, {'complete_samples': 0})\n",
    "    if stats['complete_samples'] >= config.samples_per_config:\n",
    "        configs_complete.append(cfg)\n",
    "    else:\n",
    "        configs_to_process.append(cfg)\n",
    "\n",
    "logger.info('='*60)\n",
    "logger.info(f'SPLIT STATUS')\n",
    "logger.info(f'  Total splits: {len(ALL_CAULDRON_CONFIGS)}')\n",
    "logger.info(f'  Already complete (>={config.samples_per_config}): {len(configs_complete)}')\n",
    "logger.info(f'  To process: {len(configs_to_process)}')\n",
    "logger.info('='*60)\n",
    "\n",
    "if configs_complete:\n",
    "    logger.info(f'Complete splits: {\", \".join(configs_complete[:10])}{\"...\" if len(configs_complete) > 10 else \"\"}')"
   ]
  },
