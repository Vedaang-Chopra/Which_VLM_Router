   "source": [
    "# VLM client setup\n",
    "from inference_engine.client import WhichVLMClient\n",
    "from ares.evaluation.sample_processor import process_sample_normalized\n",
    "from ares.utils.common_utils import return_model_specs\n",
    "from ares.data.dataset_loader import CauldronLoader\n",
    "from ares.evaluation.evaluation import Scorer\n",
    "from ares.metrics.metrics_client import GPUMetricsClient\n",
    "from ares.db.operations import get_existing_responses\n",
    "\n",
    "vlm_client = WhichVLMClient.from_yaml(config.models_yaml, max_workers=10)\n",
    "gpu_endpoints = {\n",
    "    'gemma_3_27b': 'http://localhost:9000/metrics',\n",
    "    'qwen3_vl_8b_thinking': 'http://localhost:9001/metrics',\n",
    "    'qwen2_5_vl_7b': 'http://localhost:9002/metrics',\n",
    "    'qwen2_5_vl_3b': 'http://localhost:9003/metrics',\n",
    "    'deepseek_ocr': 'http://localhost:9004/metrics',\n",
    "}\n",
    "gpu_client = GPUMetricsClient(endpoints=gpu_endpoints)\n",
    "model_specs = return_model_specs()\n",
    "scorer = Scorer()\n",
    "db_lock = threading.Lock()\n",
    "\n",
    "logger.info('VLM clients initialized!')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Progress tracker\n",
    "class SplitTracker:\n",
    "    def __init__(self, configs: List[str], target_per_split: int):\n",
    "        self.target = target_per_split\n",
    "        self.start_time = time.time()\n",
    "        self.lock = threading.Lock()\n",
    "        self.status = {cfg: {'status': 'PENDING', 'done': 0, 'skipped': 0, 'errors': 0, 'start': None} \n",
    "                       for cfg in configs}\n",
    "        self.completed = 0\n",
    "    \n",
    "    def start_split(self, cfg: str, already_have: int, to_process: int):\n",
    "        with self.lock:\n",
    "            self.status[cfg]['status'] = 'RUNNING'\n",
    "            self.status[cfg]['done'] = already_have\n",
    "            self.status[cfg]['to_process'] = to_process\n",
    "            self.status[cfg]['start'] = time.time()\n",
    "        logger.info(f'[{cfg}] Starting: have {already_have}, need {to_process} more')\n",
    "    \n",
    "    def update(self, cfg: str, done_delta: int = 0, error_delta: int = 0):\n",
    "        with self.lock:\n",
    "            self.status[cfg]['done'] += done_delta\n",
    "            self.status[cfg]['errors'] += error_delta\n",
    "            \n",
    "            # Log every N samples\n",
    "            done = self.status[cfg]['done']\n",
    "            if done > 0 and done % config.log_every_n == 0:\n",
    "                elapsed = time.time() - self.status[cfg]['start']\n",
    "                rate = done / elapsed if elapsed > 0 else 0\n",
    "                logger.info(f'[{cfg}] {done}/{self.target} ({rate:.1f}/s)')\n",
    "    \n",
    "    def complete_split(self, cfg: str):\n",
    "        with self.lock:\n",
    "            self.status[cfg]['status'] = 'DONE'\n",
    "            self.completed += 1\n",
    "            elapsed = time.time() - (self.status[cfg]['start'] or time.time())\n",
    "        s = self.status[cfg]\n",
    "        logger.info(f'[{cfg}] ✓ Complete: {s[\"done\"]}/{self.target} in {elapsed:.1f}s')\n",
    "    \n",
    "    def skip_split(self, cfg: str, reason: str):\n",
    "        with self.lock:\n",
    "            self.status[cfg]['status'] = 'SKIPPED'\n",
    "            self.completed += 1\n",
    "        logger.info(f'[{cfg}] ⏭ Skipped: {reason}')\n",
    "    \n",
    "    def get_summary(self) -> str:\n",
    "        with self.lock:\n",
    "            done = sum(1 for s in self.status.values() if s['status'] in ('DONE', 'SKIPPED'))\n",
    "            running = sum(1 for s in self.status.values() if s['status'] == 'RUNNING')\n",
    "            pending = sum(1 for s in self.status.values() if s['status'] == 'PENDING')\n",
    "            total_samples = sum(s['done'] for s in self.status.values())\n",
    "            elapsed = time.time() - self.start_time\n",
    "        return f'Splits: {done}✓ {running}⏳ {pending}○ | Samples: {total_samples} | Time: {elapsed:.0f}s'\n",
    "\n",
    "tracker = SplitTracker(configs_to_process, config.samples_per_config)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Sample processing function\n",
    "def process_single_sample(args):\n",
    "    sample, idx, source_config, models_to_run = args\n",
    "    try:\n",
    "        result = process_sample_normalized(\n",
    "            sample=sample,\n",
    "            sample_idx=idx,\n",
    "            source_config=source_config,\n",
    "            vlm_client=vlm_client,\n",
    "            gpu_client=gpu_client,\n",
    "            scorer=scorer,\n",
    "            config=config,\n",
    "            model_specs=model_specs,\n",
    "            models_to_run=models_to_run,\n",
    "        )\n",
    "        return ('success', result)\n",
    "    except Exception as e:\n",
    "        return ('error', str(e))\n",
    "\n",
    "\n",
    "def process_single_config(source_config: str) -> Dict[str, Any]:\n",
    "    '''Process a single Cauldron split.'''\n",
    "    results = {'config': source_config, 'processed': 0, 'skipped': 0, 'errors': 0}\n",
    "    \n",
    "    # Check how many complete samples we already have for this split\n",
    "    stats = split_status.get(source_config, {'complete_samples': 0})\n",
    "    already_complete = stats.get('complete_samples', 0)\n",
    "    \n",
    "    if already_complete >= config.samples_per_config:\n",
    "        tracker.skip_split(source_config, f'Already have {already_complete} complete')\n",
    "        results['skipped'] = already_complete\n",
    "        return results\n",
    "    \n",
    "    # Calculate how many more we need\n",
    "    samples_needed = config.samples_per_config - already_complete\n",
    "    \n",
    "    # Load samples (random)\n",
    "    try:\n",
    "        samples = CauldronLoader.load_samples(\n",
    "            source_config, \n",
    "            n_samples=samples_needed + 50,  # Load extra to account for failures\n",
    "            random_sample=True\n",
    "        )\n",
    "    except Exception as e:\n",
    "        logger.error(f'[{source_config}] Load failed: {e}')\n",
    "        return results\n",
    "    \n",
    "    # Generate sample_ids and check which exist\n",
    "    sample_ids = []\n",
    "    for idx, sample in enumerate(samples):\n",
    "        hash_input = f\"{source_config}_{idx}_{sample.get('question', '')[:50]}\"\n",
    "        hash_val = hashlib.md5(hash_input.encode()).hexdigest()[:8]\n",
    "        sample_ids.append(f\"{source_config}_{idx}_{hash_val}\")\n",
    "    \n",
    "    # Check existing responses\n",
    "    existing_responses = get_existing_responses(sample_ids)\n",
    "    \n",
    "    # Prepare work items (only incomplete samples)\n",
    "    work_items = []\n",
    "    for idx, sample in enumerate(samples):\n",
    "        if len(work_items) >= samples_needed:\n",
    "            break\n",
    "        sample_id = sample_ids[idx]\n",
    "        existing_models = existing_responses.get(sample_id, set())\n",
    "        if len(existing_models) >= 5:\n",
    "            continue  # Already complete\n",
    "        models_to_run = [m for m in MODEL_NAMES if m not in existing_models]\n",
    "        work_items.append((sample, idx, source_config, models_to_run))\n",
    "    \n",
    "    tracker.start_split(source_config, already_complete, len(work_items))\n",
    "    \n",
    "    if not work_items:\n",
    "        tracker.complete_split(source_config)\n",
    "        return results\n",
    "    \n",
    "    # Process with threading\n",
    "    sample_batch, image_batch, response_batch = [], [], []\n",
    "    \n",
    "    with ThreadPoolExecutor(max_workers=config.max_sample_workers) as executor:\n",
    "        futures = [executor.submit(process_single_sample, item) for item in work_items]\n",
    "        \n",
    "        for future in as_completed(futures):\n",
    "            status, result = future.result()\n",
    "            \n",
    "            if status == 'success' and result:\n",
    "                sample_record, image_record, response_records = result\n",
    "                sample_batch.append(sample_record)\n",
    "                image_batch.append(image_record)\n",
    "                response_batch.extend(response_records)\n",
    "                results['processed'] += 1\n",
    "                tracker.update(source_config, done_delta=1)\n",
    "                \n",
    "                # Batch insert\n",
    "                if len(sample_batch) >= config.batch_insert_size:\n",
    "                    with db_lock:\n",
    "                        insert_images(image_batch)\n",
    "                        insert_samples(sample_batch)\n",
    "                        insert_responses(response_batch)\n",
    "                    sample_batch, image_batch, response_batch = [], [], []\n",
    "            else:\n",
    "                results['errors'] += 1\n",
    "                tracker.update(source_config, error_delta=1)\n",
    "    \n",
    "    # Final batch\n",
    "    if sample_batch:\n",
    "        with db_lock:\n",
    "            insert_images(image_batch)\n",
    "            insert_samples(sample_batch)\n",
    "            insert_responses(response_batch)\n",
    "    \n",
    "    tracker.complete_split(source_config)\n",
    "    return results"
   ]
  },
  {
