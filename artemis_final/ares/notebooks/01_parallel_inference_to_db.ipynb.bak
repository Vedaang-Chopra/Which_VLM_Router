   "source": [
    "# Check split completion status from DB\n",
    "def get_split_status() -> Dict[str, Dict[str, int]]:\n",
    "    '''Get completion status for each split.\n",
    "    Returns dict: {source_config: {total_samples, complete_samples, total_responses}}\n",
    "    A sample is 'complete' if it has all 5 model responses.\n",
    "    '''\n",
    "    query = '''\n",
    "    WITH sample_response_counts AS (\n",
    "        SELECT s.source_config, s.sample_id,\n",
    "               COUNT(DISTINCT r.model_name) as model_count\n",
    "        FROM vlm_samples s\n",
    "        LEFT JOIN vlm_responses r ON s.sample_id = r.sample_id AND r.ok = true\n",
    "        GROUP BY s.source_config, s.sample_id\n",
    "    )\n",
    "    SELECT source_config,\n",
    "           COUNT(*) as total_samples,\n",
    "           SUM(CASE WHEN model_count >= 5 THEN 1 ELSE 0 END) as complete_samples,\n",
    "           SUM(model_count) as total_responses\n",
    "    FROM sample_response_counts\n",
    "    GROUP BY source_config\n",
    "    '''\n",
    "    \n",
    "    df = pd.read_sql(query, engine)\n",
    "    status = {}\n",
    "    for _, row in df.iterrows():\n",
    "        status[row['source_config']] = {\n",
    "            'total_samples': int(row['total_samples']),\n",
    "            'complete_samples': int(row['complete_samples']),\n",
    "            'total_responses': int(row['total_responses'])\n",
    "        }\n",
    "    return status\n",
    "\n",
    "split_status = get_split_status()\n",
    "logger.info(f'Found {len(split_status)} splits in DB')\n",
    "\n",
    "# Show top splits by completion\n",
    "for cfg, stats in sorted(split_status.items(), key=lambda x: -x[1]['complete_samples'])[:10]:\n",
    "    status_icon = '✓' if stats['complete_samples'] >= config.samples_per_config else '⏳'\n",
    "    logger.info(f\"  {status_icon} {cfg}: {stats['complete_samples']}/{config.samples_per_config} complete\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
