    "# Check final DB status\n",
    "final_status = get_split_status()\n",
    "\n",
    "complete_count = sum(1 for s in final_status.values() if s['complete_samples'] >= config.samples_per_config)\n",
    "logger.info(f'\\nFinal Status: {complete_count}/{len(ALL_CAULDRON_CONFIGS)} splits complete')\n",
    "\n",
    "# Show incomplete\n",
    "incomplete = [(cfg, s) for cfg, s in final_status.items() if s['complete_samples'] < config.samples_per_config]\n",
    "if incomplete:\n",
    "    logger.info('\\nIncomplete splits:')\n",
    "    for cfg, s in sorted(incomplete, key=lambda x: -x[1]['complete_samples'])[:10]:\n",
    "        logger.info(f\"  {cfg}: {s['complete_samples']}/{config.samples_per_config}\")"
   ]
