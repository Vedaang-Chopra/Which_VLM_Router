    "@dataclass\n",
    "class InferenceConfig:\n",
    "    run_id: str = field(default_factory=lambda: f\"run_{datetime.now().strftime('%Y%m%d_%H%M%S')}\")\n",
    "    models_yaml: str = '/Users/vedaangchopra/all_data/complete_technical_work/all_projects_implemented/Which_VLM_Router/artemis_final/ares/configs/models.yaml'\n",
    "    \n",
    "    # KEY SETTING: samples per split\n",
    "    samples_per_config: int = 1000\n",
    "    \n",
    "    # Data split\n",
    "    train_ratio: float = 0.70\n",
    "    val_ratio: float = 0.15\n",
    "    \n",
    "    # VLM settings\n",
    "    temperature: float = 0.0\n",
    "    max_tokens: int = 512\n",
    "    \n",
    "    # Parallelism\n",
    "    max_config_workers: int = 8\n",
    "    max_sample_workers: int = 16\n",
    "    batch_insert_size: int = 25\n",
    "    \n",
    "    # Logging\n",
    "    log_every_n: int = 10\n",
    "\n",
    "config = InferenceConfig()\n",
    "logger.info(f'Run ID: {config.run_id}')\n",
    "logger.info(f'Target: {config.samples_per_config} samples per split')"
   ]
